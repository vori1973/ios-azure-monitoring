POC_MODE=local
BACKEND_HOST=0.0.0.0
BACKEND_PORT=3001
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=3000
BACKEND_URL=http://localhost:3001
GATEWAY_URL=http://localhost:3000
LOCAL_AUTH_TOKEN=replace-with-local-demo-token
LOCAL_INGESTION_PATH=.local-data/business-events.ndjson
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=external-mobile-simulator

# Required only when POC_MODE=azure.
AZURE_LOGS_ENDPOINT=https://replace-with-dce.ingest.monitor.azure.com
AZURE_DCR_IMMUTABLE_ID=dcr-replace-with-immutable-id
AZURE_DCR_STREAM_NAME=Custom-ExternalMobileEvents
APPLICATIONINSIGHTS_CONNECTION_STRING=replace-with-application-insights-connection-string
APIM_TRUST_HEADER_NAME=x-apim-authenticated
APIM_TRUST_HEADER_VALUE=replace-with-gateway-managed-value
