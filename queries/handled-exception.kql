// Parameters: replace <correlation-id> and adjust the time range.
let TargetCorrelationId = "<correlation-id>";
AppExceptions
| where TimeGenerated >= ago(2h)
| where tostring(Properties["correlation.id"]) == TargetCorrelationId
| where tostring(Properties["exception.handled"]) == "true"
| project TimeGenerated, OperationId, ExceptionType, OuterMessage
