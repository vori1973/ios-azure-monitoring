{
  "name": "external-mobile-telemetry-poc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <26"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"{src,tests,scripts}/**/*.{ts,mjs}\" \"*.{json,js,ts,yml}\" \"docs/**/*.md\" README.md AGENTS.md docker-compose.yml",
    "format:check": "prettier --check \"{src,tests,scripts}/**/*.{ts,mjs}\" \"*.{json,js,ts,yml}\" \"docs/**/*.md\" README.md AGENTS.md docker-compose.yml",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "scan:secrets": "node scripts/scan-secrets.mjs .",
    "backend": "tsx src/backend/server.ts",
    "gateway": "tsx src/gateway/server.ts",
    "journey": "tsx src/simulator/index.ts",
    "package:simulator": "npm run build && node scripts/package-simulator.mjs",
    "check:simulator-package": "node scripts/check-simulator-package.mjs",
    "docker:prepare": "npm run build && node scripts/prepare-docker-build.mjs",
    "local:up": "npm run docker:prepare && docker compose up --build --wait",
    "local:down": "docker compose down --remove-orphans && node scripts/cleanup-local.mjs",
    "infra:validate": "az bicep build --file infra/main.bicep --stdout > /dev/null && node scripts/validate-apim-policy.mjs && node scripts/validate-assets.mjs"
  },
  "dependencies": {
    "@azure/identity": "^4.13.3",
    "@azure/monitor-ingestion": "^1.2.0",
    "@fastify/rate-limit": "^11.2.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/context-async-hooks": "^2.11.0",
    "@opentelemetry/core": "^2.11.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-trace-base": "^2.11.0",
    "@opentelemetry/sdk-trace-node": "^2.11.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "fastify": "^5.12.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.3",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.10.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.1.11"
  }
}
