FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production
COPY package.json package-lock.json ./
COPY .docker-build/npm-cache /tmp/npm-cache
RUN npm ci --omit=dev --offline --no-audit --no-fund --cache /tmp/npm-cache \
    && rm -rf /tmp/npm-cache
COPY dist ./dist
USER node
CMD ["node", "dist/gateway/server.js"]
